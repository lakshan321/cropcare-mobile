{
  "expo": {
    "name": "CropCare",
    "slug": "cropcare",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "cropcare",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#196448"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.we178.cropcare",
      "infoPlist": {
        "NSCameraUsageDescription": "CropCare needs camera access to photograph crop leaves for disease diagnosis.",
        "NSPhotoLibraryUsageDescription": "CropCare needs photo library access to upload crop photographs."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#196448"
      },
      "package": "com.we178.cropcare",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.INTERNET"
      ]
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "CropCare needs access to your photos to analyze plant leaf health.",
          "cameraPermission": "CropCare needs camera access to take clear photos of plant leaves."
        }
      ],
      "expo-secure-store"
    ],
    "extra": {
      "apiUrl": "http://192.168.1.27:5000",
      "eas": {
        "projectId": "cropcare-we178"
      }
    }
  }
}
